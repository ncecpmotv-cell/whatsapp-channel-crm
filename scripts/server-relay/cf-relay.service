[Unit]
Description=Authenticated reverse proxy for phone CRM (127.0.0.1:18082 -> 18081)
After=network.target

[Service]
Type=simple
User=ubuntu
EnvironmentFile=/opt/cf-relay/relay.env
ExecStart=/usr/bin/python3 /opt/cf-relay/relay.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
