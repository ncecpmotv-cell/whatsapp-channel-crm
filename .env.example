# Copy to etc/crm.env (or export) and fill in. scripts/install.sh generates this for you.
# chmod 600 the file: it holds the only password to the UI and the MCP endpoint.

# --- GOWA (WhatsApp gateway) -------------------------------------------------
GOWA_BASE_URL=http://127.0.0.1:3000
GOWA_DEVICE_ID=primary
# Shared secret for the HMAC signature on /webhook/gowa
# python3 -c "import secrets;print(secrets.token_hex(32))"
GOWA_WEBHOOK_SECRET=change-me-64-hex-chars
# Basic auth for the GOWA REST API (the same pair lives in gowa.env APP_BASIC_AUTH)
GOWA_USER=crm
GOWA_PASSWORD=change-me

# --- HTTP server: UI + /mcp + /webhook/gowa on one loopback port -------------
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8085
# Bearer token for /mcp, /status and /hook/publish; also the UI password
BRIDGE_TOKEN=change-me-64-hex-chars

# --- WhatsApp Channels to monitor --------------------------------------------
# Comma-separated JIDs, e.g. 120363024512399999@newsletter
NEWSLETTER_JIDS=

# --- Storage -----------------------------------------------------------------
CRM_DB_PATH=./var/crm.db
MEDIA_DIR=./var/media
STATIC_CACHE=./var/static

# --- Policy ------------------------------------------------------------------
# 0 = agents draft and propose times, a human publishes.
# 1 = agents may move posts into 'scheduled' themselves.
AGENT_CAN_PUBLISH=0
DAILY_PUBLISH_CAP=30
# Local timezone offset in hours, used to format timestamps
TZ_OFFSET=3
# Country code used to normalise numbers that arrive without one
DEFAULT_COUNTRY_CODE=966

# --- Worker ------------------------------------------------------------------
BRIDGE_POLL_INTERVAL=15
BRIDGE_CHANNEL_SYNC_INTERVAL=300
