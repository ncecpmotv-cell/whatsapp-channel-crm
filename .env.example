# ---------------------------------------------------------------------------
# Local CRM + GOWA bridge — copy to ~/gowa-espo/.env and fill in.
# chmod 600 ~/gowa-espo/.env
# ---------------------------------------------------------------------------

# GOWA (WhatsApp) REST API — loopback only
GOWA_BASE_URL=http://127.0.0.1:3000
# Device slot id. GOWA creates it from the linked account when the QR is
# scanned without a pre-registered slot; "primary" is the default.
GOWA_DEVICE_ID=primary
# Shared secret used to sign GOWA webhooks (X-Hub-Signature-256).
# Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
GOWA_WEBHOOK_SECRET=change-me-64-hex-chars

# HTTP server: UI + /mcp + /webhook/gowa on one port
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8085
# Bearer token for /mcp and /hook/publish, and the UI password (any username).
# Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
BRIDGE_TOKEN=change-me-64-hex-chars

# WhatsApp Channels (@newsletter) to monitor and publish to.
# Comma-separated JIDs, e.g. 120363024512399999@newsletter
NEWSLETTER_JIDS=

# Used to normalise local numbers that arrive without a country code
DEFAULT_COUNTRY_CODE=966

# SQLite file: contacts, posts, deals, messages, activities, outbox
CRM_DB_PATH=/data/data/com.termux/files/home/gowa-espo/var/crm.db

# Approval policy: 0 = agents draft and propose times; a human publishes.
# 1 = agents may move posts into 'scheduled' themselves.
AGENT_CAN_PUBLISH=0

# Safety cap for publishing
DAILY_PUBLISH_CAP=30

# Runtime
BRIDGE_POLL_INTERVAL=60
BRIDGE_CHANNEL_SYNC_INTERVAL=300
BRIDGE_LOG_LEVEL=INFO
