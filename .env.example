# ---------------------------------------------------------------------------
# GOWA <-> EspoCRM bridge — copy to ~/gowa-espo/.env and fill in.
# chmod 600 ~/gowa-espo/.env
# ---------------------------------------------------------------------------

# GOWA (WhatsApp) REST API — loopback only
GOWA_BASE_URL=http://127.0.0.1:3000
# Device slot id. GOWA creates it from the linked account (e.g. 9665...:13@s.whatsapp.net)
# when the QR is scanned without a pre-registered slot; "primary" is the default.
GOWA_DEVICE_ID=primary
# Shared secret used to sign GOWA webhooks (X-Hub-Signature-256).
# Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
GOWA_WEBHOOK_SECRET=change-me-64-hex-chars

# Bridge HTTP server
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8085
# Bearer token that EspoCRM must present on /webhook/espocrm.
# Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
BRIDGE_TOKEN=change-me-64-hex-chars

# EspoCRM REST API
ESPO_BASE_URL=http://127.0.0.1:8081
ESPO_USER=wa-bridge
# Generated in EspoCRM: Admin > API Users > your user > Generate API Key
# (or POST /api/v1/UserSecurity/apiKey/generate with {"id": "<userId>"})
ESPO_API_KEY=

# EspoCRM bootstrap (used only by scripts/setup-espocrm.sh on first install)
ESPO_DB_PASSWORD=change-me-db-password
ESPO_ADMIN_PASSWORD=change-me-admin-password

# WhatsApp Channels (@newsletter) to monitor and allow publishing to.
# Comma-separated JIDs, e.g. 120363024512399999@newsletter
# Leave empty to auto-monitor every channel the linked account follows.
NEWSLETTER_JIDS=

# Used to normalise local numbers that arrive without a country code
DEFAULT_COUNTRY_CODE=966

# Runtime
BRIDGE_DB_PATH=/data/data/com.termux/files/home/gowa-espo/var/bridge.db
BRIDGE_POLL_INTERVAL=60
BRIDGE_CHANNEL_SYNC_INTERVAL=300
BRIDGE_LOG_LEVEL=INFO
